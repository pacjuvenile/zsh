ZSH_CONFIG_PATH="${HOME}/dotfiles/zshell/zsh"

# 选项配置
source "${ZSH_CONFIG_PATH}/custom/core/options.zsh"
# 插件配置
source "${ZSH_CONFIG_PATH}/custom/core/plugin_manager.zsh"
# 环境设置
source "${ZSH_CONFIG_PATH}/custom/core/envs.zsh"
# 键位设置
source "${ZSH_CONFIG_PATH}/custom/core/keymaps.zsh"
# 函数设置
source "${ZSH_CONFIG_PATH}/custom/core/functions.zsh"
